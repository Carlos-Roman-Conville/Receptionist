# Copy to .env and fill in. Never commit .env

CLIENT_SLUG=crc-solutions
DEPLOYMENT_KIT_PATH=E:/shared programs/Business Model/Deployment Kit

# APIs
ANTHROPIC_API_KEY=
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Google Calendar
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# Emergency (E.164, not published)
EMERGENCY_TRANSFER_NUMBER=

# Alerts (Pushover)
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# Database
DATABASE_URL=postgresql://receptionist:receptionist@localhost:5432/receptionist

# Chat security
CHAT_ALLOWED_ORIGINS=https://crc-solutions.org

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
LEAD_NOTIFY_EMAIL=carlos@crc-solutions.org
