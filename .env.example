# Copy to .env and fill in. Never commit .env

CLIENT_SLUG=crc-solutions
DEPLOYMENT_KIT_PATH=E:/shared programs/Business Model/Deployment Kit

# APIs
ANTHROPIC_API_KEY=
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Google Calendar — run once after client ID/secret: npm run calendar:oauth
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# Emergency (E.164, not published)
EMERGENCY_TRANSFER_NUMBER=

# Alerts (Pushover)
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# Voice service
VOICE_PORT=3001
VOICE_HOST=0.0.0.0
# Public WSS base (no /media path). Required for Telnyx streaming.
VOICE_PUBLIC_WS_URL=wss://voice.crc-solutions.org
TELNYX_SKIP_SIGNATURE=0

# Database
DATABASE_URL=postgresql://receptionist:receptionist@localhost:5432/receptionist

# Async service (n8n HTTP triggers)
ASYNC_PORT=3002
ASYNC_HOST=0.0.0.0
ASYNC_WEBHOOK_SECRET=

# Chat security
CHAT_ALLOWED_ORIGINS=https://crc-solutions.org
CHAT_ALLOW_NO_ORIGIN=1
CHAT_PORT=3000
CHAT_HOST=0.0.0.0
CHAT_RATE_LIMIT_MAX=20
CHAT_RATE_LIMIT_WINDOW_MS=3600000

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
LEAD_NOTIFY_EMAIL=carlos@crc-solutions.org
